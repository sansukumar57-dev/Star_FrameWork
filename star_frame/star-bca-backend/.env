PORT=
NODE_ENV=
MONGO_URI=
JWT_SECRET=
CORS_ORIGIN=

# AI Evidence Reviewer (optional). Leave keys empty to use the rule-engine fallback.
AI_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Evidence virus scanning (optional). Set CLAMAV_HOST to enable ClamAV scanning.
# Leave empty to pass files through with a warning.
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

# Deadline notification broadcast (scheduled)
DEADLINE_BROADCAST_ENABLED=
DEADLINE_BROADCAST_WINDOW_DAYS=
DEADLINE_BROADCAST_INTERVAL_MS=
